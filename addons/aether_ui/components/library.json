		"SimplePanel": {"native_type": "Panel", "style": "inset"},
		"SectionPanel": {"native_type": "Panel", "style": "panel"},
		"PrimaryButton": {"native_type": "Button", "style": "button_primary", "states": ["normal", "hover", "pressed", "focused", "disabled"]},
		"SecondaryButton": {"native_type": "Button", "style": "button_secondary", "states": ["normal", "hover", "pressed", "focused", "disabled"]},
		"IconButton": {"native_type": "TextureButton", "style": "button_secondary"},
