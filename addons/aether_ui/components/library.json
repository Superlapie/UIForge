		"ScrollList": {"native_type": "ScrollContainer", "style": "inset"},
		"Tooltip": {"native_type": "Panel", "style": "panel"},
		"ContextMenu": {"native_type": "Panel", "style": "panel", "composes": ["ContextMenuEntry"]},
		"ContextMenuEntry": {"native_type": "Button", "style": "button_secondary"},
		"ModalDialog": {"native_type": "Panel", "style": "window", "composes": ["PrimaryButton", "SecondaryButton"]},
