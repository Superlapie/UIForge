{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://internal/aether-ui/schema/1",
	"title": "Aether UI Document",
	"description": "Canonical, human-readable source format for native Godot game UI.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"name",
		"viewport",
		"theme",
		"root"
	],
	"properties": {
		"schema_version": {
			"const": 1
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"pattern": "^[A-Za-z0-9_-]+$"
		},
		"viewport": {
			"$ref": "#/$defs/viewport"
		},
		"theme": {
			"type": "string",
			"minLength": 1
		},
		"root": {
			"$ref": "#/$defs/node"
		},
		"components": {
			"type": "object",
			"additionalProperties": {
				"$ref": "#/$defs/component_definition"
			}
		},
		"theme_overrides": {
			"$ref": "#/$defs/theme_overrides"
		},
		"metadata": {
			"type": "object"
		},
		"mock_data": {
			"type": "object"
		},
		"reference": {
			"$ref": "#/$defs/reference"
		}
	},
	"$defs": {
		"viewport": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"width",
				"height"
			],
			"properties": {
				"width": {
					"type": "integer",
					"minimum": 1
				},
				"height": {
					"type": "integer",
					"minimum": 1
				},
				"scale_mode": {
					"enum": [
						"fixed",
						"viewport",
						"fit",
						"integer"
					]
				},
				"safe_zone": {
					"type": "number",
					"minimum": 0,
					"maximum": 0.5
				}
			}
		},
		"node": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"type"
			],
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1,
					"pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
				},
				"name": {
					"type": "string"
				},
				"type": {
					"type": "string",
					"minLength": 1
				},
				"component": {
					"type": "string"
				},
				"overrides": {
					"type": "object"
				},
				"base_type": {
					"type": "string"
				},
				"layout": {
					"$ref": "#/$defs/layout"
				},
				"properties": {
					"$ref": "#/$defs/node_properties"
				},
				"style": {
					"oneOf": [
						{
							"type": "string"
						},
						{
							"type": "object"
						}
					]
				},
				"background_style": {
					"type": "string"
				},
				"fill_style": {
					"type": "string"
				},
				"states": {
					"type": "object",
					"additionalProperties": {
						"type": "object"
					}
				},
				"action": {
					"type": "string"
				},
				"binding": {
					"type": "string"
				},
				"effects": {
					"oneOf": [
						{
							"type": "string"
						},
						{
							"type": "object"
						},
						{
							"type": "array"
						}
					]
				},
				"transitions": {
					"type": "object",
					"additionalProperties": {
						"$ref": "#/$defs/transition"
					}
				},
				"metadata": {
					"type": "object"
				},
				"mock_data": {
					"type": "object"
				},
				"decorations": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": {
								"$ref": "#/$defs/decoration"
							}
						},
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/decoration"
							}
						}
					]
				},
				"children": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/node"
					}
				}
			}
		},
		"layout": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"position": {
					"$ref": "#/$defs/vec2"
				},
				"size": {
					"$ref": "#/$defs/vec2"
				},
				"min_size": {
					"$ref": "#/$defs/vec2"
				},
				"max_size": {
					"$ref": "#/$defs/vec2"
				},
				"anchors": {
					"type": "object",
					"properties": {
						"left": {
							"type": "number"
						},
						"top": {
							"type": "number"
						},
						"right": {
							"type": "number"
						},
						"bottom": {
							"type": "number"
						}
					},
					"additionalProperties": false
				},
				"offsets": {
					"type": "object",
					"properties": {
						"left": {
							"type": "number"
						},
						"top": {
							"type": "number"
						},
						"right": {
							"type": "number"
						},
						"bottom": {
							"type": "number"
						}
					},
					"additionalProperties": false
				},
				"anchors_preset": {
					"enum": [
						"full_rect",
						"top_left",
						"center",
						"bottom_right"
					]
				},
				"padding": {
					"oneOf": [
						{
							"type": "number"
						},
						{
							"type": "object"
						}
					]
				},
				"gap": {
					"type": "number",
					"minimum": 0
				},
				"grow": {
					"type": "object"
				},
				"grow_horizontal": {
					"type": "integer",
					"minimum": 0,
					"maximum": 2
				},
				"grow_vertical": {
					"type": "integer",
					"minimum": 0,
					"maximum": 2
				},
				"size_flags_horizontal": {
					"type": "integer",
					"minimum": 0
				},
				"size_flags_vertical": {
					"type": "integer",
					"minimum": 0
				},
				"size_flags_stretch_ratio": {
					"type": "number",
					"minimum": 0
				},
				"z_index": {
					"type": "integer"
				},
				"mouse_filter": {
					"type": "integer",
					"minimum": 0,
					"maximum": 2
				},
				"pivot": {
					"$ref": "#/$defs/vec2"
				},
				"rotation_degrees": {
					"type": "number"
				},
				"scale": {
					"$ref": "#/$defs/vec2"
				},
				"layout_mode": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				}
			}
		},
		"vec2": {
			"type": "array",
			"prefixItems": [
				{
					"type": "number"
				},
				{
					"type": "number"
				}
			],
			"minItems": 2,
			"maxItems": 2
		},
		"node_properties": {
			"type": "object",
			"description": "Canonical semantic properties plus optional native Godot property overrides.",
			"properties": {
				"text": {
					"type": "string"
				},
				"title": {
					"type": "string"
				},
				"label": {
					"type": "string"
				},
				"count": {
					"type": [
						"string",
						"number"
					]
				},
				"show_label": {
					"type": "boolean"
				},
				"columns": {
					"type": "integer",
					"minimum": 0
				},
				"slot_size": {
					"$ref": "#/$defs/token_number"
				},
				"gap": {
					"$ref": "#/$defs/token_number"
				},
				"value": {
					"$ref": "#/$defs/token_number"
				},
				"min_value": {
					"$ref": "#/$defs/token_number"
				},
				"max_value": {
					"$ref": "#/$defs/token_number"
				},
				"step": {
					"$ref": "#/$defs/token_number"
				},
				"placeholder": {
					"type": "string"
				},
				"max_length": {
					"type": "integer",
					"minimum": 0
				},
				"tick_count": {
					"type": "integer",
					"minimum": 0
				},
				"show_percentage": {
					"type": "boolean"
				},
				"texture": {
					"type": "string"
				},
				"icon": {
					"type": "string"
				},
				"font": {
					"type": "string"
				},
				"material": {
					"type": "string"
				},
				"theme": {
					"type": "string"
				},
				"font_size": {
					"$ref": "#/$defs/token_number"
				},
				"color": {
					"$ref": "#/$defs/color_value"
				},
				"opacity": {
					"$ref": "#/$defs/token_number"
				},
				"modulate": {
					"$ref": "#/$defs/color_value"
				},
				"self_modulate": {
					"$ref": "#/$defs/color_value"
				},
				"outline_size": {
					"$ref": "#/$defs/token_number"
				},
				"font_outline_color": {
					"$ref": "#/$defs/color_value"
				},
				"font_shadow_color": {
					"$ref": "#/$defs/color_value"
				},
				"horizontal_alignment": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"vertical_alignment": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"alignment": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"autowrap": {
					"type": "boolean"
				},
				"clip_text": {
					"type": "boolean"
				},
				"text_overrun_behavior": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"bbcode_enabled": {
					"type": "boolean"
				},
				"fit_content": {
					"type": "boolean"
				},
				"scroll_active": {
					"type": "boolean"
				},
				"disabled": {
					"type": "boolean"
				},
				"editable": {
					"type": "boolean"
				},
				"focus_mode": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"tooltip": {
					"type": "string"
				},
				"toggle_mode": {
					"type": "boolean"
				},
				"button_pressed": {
					"type": "boolean"
				},
				"flat": {
					"type": "boolean"
				},
				"expand_icon": {
					"type": "boolean"
				},
				"icon_alignment": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"secret": {
					"type": "boolean"
				},
				"clear_button_enabled": {
					"type": "boolean"
				},
				"caret_blink": {
					"type": "boolean"
				},
				"selecting_enabled": {
					"type": "boolean"
				},
				"context_menu_enabled": {
					"type": "boolean"
				},
				"select_all_on_focus": {
					"type": "boolean"
				},
				"virtual_keyboard_enabled": {
					"type": "boolean"
				},
				"ticks_on_borders": {
					"type": "boolean"
				},
				"allow_greater": {
					"type": "boolean"
				},
				"allow_lesser": {
					"type": "boolean"
				},
				"horizontal_scroll_mode": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"vertical_scroll_mode": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"separation": {
					"$ref": "#/$defs/token_number"
				},
				"visible": {
					"type": "boolean"
				},
				"clip_contents": {
					"type": "boolean"
				},
				"show_behind_parent": {
					"type": "boolean"
				},
				"top_level": {
					"type": "boolean"
				},
				"z_as_relative": {
					"type": "boolean"
				},
				"y_sort_enabled": {
					"type": "boolean"
				},
				"use_parent_material": {
					"type": "boolean"
				},
				"clip_children": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"texture_filter": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"texture_repeat": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"light_mask": {
					"type": "integer",
					"minimum": 0
				},
				"visibility_layer": {
					"type": "integer",
					"minimum": 0
				},
				"theme_type_variation": {
					"type": "string"
				},
				"accessibility_name": {
					"type": "string"
				},
				"accessibility_description": {
					"type": "string"
				},
				"auto_translate": {
					"type": "boolean"
				},
				"layout_direction": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"expand_mode": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"stretch_mode": {
					"oneOf": [
						{
							"type": "integer"
						},
						{
							"type": "string"
						}
					]
				},
				"ignore_texture_size": {
					"type": "boolean"
				},
				"flip_h": {
					"type": "boolean"
				},
				"flip_v": {
					"type": "boolean"
				},
				"patch_margin_left": {
					"type": "integer",
					"minimum": 0
				},
				"patch_margin_top": {
					"type": "integer",
					"minimum": 0
				},
				"patch_margin_right": {
					"type": "integer",
					"minimum": 0
				},
				"patch_margin_bottom": {
					"type": "integer",
					"minimum": 0
				},
				"godot_overrides": {
					"type": "object",
					"description": "Native Godot property paths to JSON values. Resource values may use $resource/type, node paths may use $node_path, and structured values may use $type/value wrappers such as Vector2, Rect2, Color, or Array[NodePath]."
				},
				"texture_region": {
					"type": "array",
					"prefixItems": [
						{
							"type": "number",
							"minimum": 0
						},
						{
							"type": "number",
							"minimum": 0
						},
						{
							"type": "number",
							"exclusiveMinimum": 0
						},
						{
							"type": "number",
							"exclusiveMinimum": 0
						}
					],
					"minItems": 4,
					"maxItems": 4,
					"description": "Native AtlasTexture crop in source pixels: x, y, width, height."
				}
			},
			"additionalProperties": true
		},
		"token_number": {
			"oneOf": [
				{
					"type": "number"
				},
				{
					"type": "string",
					"pattern": "^\\$"
				}
			]
		},
		"color_value": {
			"oneOf": [
				{
					"type": "string"
				},
				{
					"type": "array",
					"items": {
						"type": "number"
					},
					"minItems": 3,
					"maxItems": 4
				}
			]
		},
		"decoration": {
			"type": "object",
			"description": "A compositional frame ornament compiled to an ordinary child Control.",
			"properties": {
				"id": {
					"type": "string"
				},
				"type": {
					"type": "string",
					"default": "Texture"
				},
				"texture": {
					"type": "string"
				},
				"position": {
					"$ref": "#/$defs/vec2"
				},
				"size": {
					"$ref": "#/$defs/vec2"
				},
				"layout": {
					"$ref": "#/$defs/layout"
				},
				"properties": {
					"$ref": "#/$defs/node_properties"
				}
			},
			"additionalProperties": true
		},
		"transition": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"preset"
			],
			"properties": {
				"preset": {
					"enum": [
						"fade",
						"scale",
						"slide",
						"hover",
						"button_press",
						"panel_reveal"
					]
				},
				"duration": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"delay": {
					"type": "number",
					"minimum": 0
				},
				"easing": {
					"enum": [
						"linear",
						"ease_in",
						"ease_out",
						"ease_in_out"
					]
				}
			}
		},
		"component_definition": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"base": {
					"type": "string"
				},
				"node": {
					"$ref": "#/$defs/node"
				},
				"native_type": {
					"type": "string"
				},
				"style": {
					"type": "string"
				},
				"properties": {
					"type": "object"
				},
				"children": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/node"
					}
				}
			}
		},
		"reference": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"path"
			],
			"properties": {
				"path": {
					"type": "string"
				},
				"opacity": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"scale": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"position": {
					"$ref": "#/$defs/vec2"
				},
				"locked": {
					"type": "boolean"
				},
				"visible": {
					"type": "boolean"
				},
				"above_canvas": {
					"type": "boolean"
				}
			}
		},
		"theme_overrides": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"tokens": {
					"type": "object"
				},
				"styles": {
					"type": "object",
					"additionalProperties": {
						"type": "object"
					}
				}
			}
		}
	}
}
